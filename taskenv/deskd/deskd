#!/usr/bin/python3
"""TaskENV desktop integration. systemd supervises; Selkies streams."""
import argparse
import json
import os
from pathlib import Path
import secrets
import subprocess
import sys
import urllib.error
import urllib.request

VERSION = '0.1.1'
DISPLAY = ':1'
PORT = 6900


def environment():
    env = os.environ.copy()
    env.update(DISPLAY=DISPLAY, XAUTHORITY=str(Path.home()/'.Xauthority'),
               XDG_RUNTIME_DIR=f'/run/user/{os.getuid()}', XDG_SESSION_TYPE='x11',
               DBUS_SESSION_BUS_ADDRESS=f'unix:path=/run/user/{os.getuid()}/bus')
    return env


def run(*args):
    return subprocess.run(args, env=environment(), capture_output=True, text=True, timeout=10)


def status():
    services = {name: run('systemctl', '--user', 'is-active', name).stdout.strip()
                for name in ('deskd-display.service', 'deskd.service')}
    display_ready = run('xdpyinfo').returncode == 0
    try:
        with urllib.request.urlopen(f'http://127.0.0.1:{PORT}/', timeout=3) as response:
            http_ready = response.status == 200
    except urllib.error.HTTPError as error:
        http_ready = error.code == 401
    except OSError:
        http_ready = False
    return {'version': VERSION, 'backend': 'selkies', 'display': DISPLAY,
            'port': PORT, 'services': services, 'display_ready': display_ready,
            'stream_ready': http_ready,
            'ready': display_ready and http_ready and all(v == 'active' for v in services.values())}


def connect_info():
    """Private connection contract, invoked through authenticated process access."""
    if os.getuid() == 0:
        raise RuntimeError('connect-info must run as the desktop user')
    if not status()['ready']:
        raise RuntimeError('desktop is not ready; run deskd check')
    try:
        auth = json.loads((Path.home()/'.config/deskd/credentials.json').read_text())
        username, password = auth['username'], auth['password']
        if (not isinstance(username, str) or not isinstance(password, str)
                or not username or ':' in username or not password
                or any(ord(c) < 32 or ord(c) == 127 for c in username + password)):
            raise ValueError('invalid credentials')
    except (OSError, ValueError, KeyError, TypeError):
        raise RuntimeError('desktop authentication is unavailable; restart deskd') from None
    return {'version': 1, 'port': PORT,
            'authentication': {'scheme': 'basic', 'username': username, 'password': password}}


def serve():
    if os.getuid() == 0:
        sys.exit('deskd must run as the desktop user')
    directory = Path.home()/'.config/deskd'
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    credentials = directory/'credentials.json'
    if not credentials.exists():
        with credentials.open('x') as output:
            output.write(json.dumps({'username': 'ubuntu', 'password': secrets.token_urlsafe(24)})+'\n')
    credentials.chmod(0o600)
    auth = json.loads(credentials.read_text())
    env = environment()
    env['SELKIES_BASIC_AUTH_USER'] = auth['username']
    env['SELKIES_BASIC_AUTH_PASSWORD'] = auth['password']
    args = ['/usr/bin/selkies', '--addr=0.0.0.0', f'--port={PORT}', '--encoder=jpeg',
            '--audio-enabled=false', '--microphone-enabled=false', '--webcam-enabled=false',
            '--gamepad-enabled=false', '--second-screen=false', '--enable-resize=false',
            '--file-manager-path='+str(Path.home()/'Shared')]
    os.execve(args[0], args, env)


def main():
    parser = argparse.ArgumentParser(description='TaskENV desktop runtime')
    parser.add_argument('--version', action='version', version='deskd '+VERSION)
    parser.add_argument('command', choices=['serve', 'status', 'check', 'connect-info', 'start', 'stop', 'restart'])
    args = parser.parse_args()
    if args.command == 'serve':
        serve()
    elif args.command == 'connect-info':
        # This is an authenticated machine interface, never a public HTTP route.
        # Do not dump credentials into an interactive terminal by accident.
        if sys.stdout.isatty():
            print('connect-info is for TaskENV GUI attachment; use deskd status for diagnostics', file=sys.stderr)
            return 1
        try:
            result = connect_info()
        except (RuntimeError, subprocess.SubprocessError, OSError) as error:
            print(str(error), file=sys.stderr)
            return 1
        print(json.dumps(result))
    elif args.command in ('status', 'check'):
        result = status()
        print(json.dumps(result))
        return 0 if result['ready'] else 1
    else:
        # Restart the stream only. Display restarts are explicit systemd actions.
        return subprocess.call(['systemctl', '--user', args.command, 'deskd.service'], env=environment())
    return 0


if __name__ == '__main__':
    sys.exit(main())
