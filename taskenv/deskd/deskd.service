[Unit]
Description=TaskENV desktop agent (Selkies)
Requires=deskd-display.service
After=deskd-display.service
PartOf=deskd-display.service

[Service]
Environment=DISPLAY=:1
Environment=XAUTHORITY=%h/.Xauthority
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStartPre=/usr/bin/timeout 15 /bin/sh -c 'until xdpyinfo >/dev/null 2>&1; do sleep 0.1; done'
ExecStart=/usr/bin/deskd serve
Restart=on-failure
RestartSec=2
UMask=0077

[Install]
WantedBy=default.target
