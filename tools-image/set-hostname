#!/agentenv/bin/busybox sh
# Used at boot and by the host after restoring older snapshots.
set -eu
BB=/agentenv/bin/busybox

$BB mkdir -p /etc
if [ -L /etc/hostname ] || [ "$($BB cat /etc/hostname 2>/dev/null)" != taskenv ]; then
    $BB rm -f /etc/hostname
    printf '%s\n' taskenv > /etc/hostname
    $BB chmod 0644 /etc/hostname
fi
$BB hostname taskenv

# Resolve the guest's own name locally, including images without nss-myhostname.
if ! $BB grep -qxF '127.0.1.1 taskenv' /etc/hosts 2>/dev/null; then
    printf '\n127.0.1.1 taskenv\n' >> /etc/hosts
fi

# Older desktop snapshots created the Xvfb cookie before the hostname fix.
# Preserve that cookie under the stable hostname so X clients remain
# authenticated after a resume.
if [ -f /home/ubuntu/.Xauthority ] && command -v xauth >/dev/null 2>&1; then
    entry="$(xauth -f /home/ubuntu/.Xauthority list 2>/dev/null | $BB head -n 1 || true)"
    set -- $entry
    if [ "$#" -ge 3 ] && [ -n "$3" ]; then
        xauth -f /home/ubuntu/.Xauthority add taskenv/unix:1 MIT-MAGIC-COOKIE-1 "$3" 2>/dev/null || true
    fi
    $BB chown ubuntu:ubuntu /home/ubuntu/.Xauthority 2>/dev/null || true
fi
